# 카카오 디벨로퍼스 앱의 REST API 키 (앱 등록 시 발급, OAuth 인가 URL 생성에 사용)
KAKAO_REST_API_KEY=

# 카카오 로그인 > 보안 메뉴에서 Client Secret 사용을 켠 경우에만 필요
KAKAO_CLIENT_SECRET=

# 카카오톡 "나에게 보내기" API용 액세스 토큰 (REST API 키로 OAuth 로그인 완료 후 발급)
KAKAO_ACCESS_TOKEN=

# 이메일 백업 채널 (예: Gmail 앱 비밀번호 사용)
EMAIL_SENDER=
EMAIL_APP_PASSWORD=
EMAIL_RECIPIENT=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
